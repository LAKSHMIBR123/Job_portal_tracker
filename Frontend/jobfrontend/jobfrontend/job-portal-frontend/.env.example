# Required for production builds (Netlify / Vercel). Public env vars must be prefixed with VITE_.
# Use your deployed API origin + /api path, no trailing slash.
# Examples:
#   VITE_API_BASE_URL=https://your-service.onrender.com/api
#   VITE_API_BASE_URL=https://your-service.up.railway.app/api
VITE_API_BASE_URL=

# EmailJS settings for real job application confirmation emails
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
