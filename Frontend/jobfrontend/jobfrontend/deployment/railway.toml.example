# Copy to your backend repo root as railway.toml (optional; Railway often auto-detects Node).
# Set start command to match your API (e.g. node server.js or npm start).
#
# After deploy, set frontend VITE_API_BASE_URL to your Railway public URL + /api, e.g.:
#   https://your-service.up.railway.app/api
#
# CORS: allow your Netlify/Vercel origin.

[build]
builder = "NIXPACKS"

[deploy]
startCommand = "npm start"
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
